/*
 * index.css — Clearward Deep Mission Amber Design System
 *
 * Design thesis: Authentic 1960s-70s NASA mission control aesthetics.
 * Near-black backgrounds, warm amber as the single primary accent (CRT phosphor),
 * calm steel blue as secondary (radar), honest green/red for data states.
 * No neon. No double-glow. Restraint is the craft.
 *
 * Supports 4 themes:
 * 1. [default] Mission Amber — near-black, warm amber, radar blue
 * 2. [theme-synthwave] Deep Violet
 * 3. [theme-matrix] Phosphor Green
 * 4. [theme-solar] Solar Gold
 */

/* ─── GOOGLE FONTS IMPORT ────────────────────────────────────────────────────── */
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');

/* ─── 1. DEEP MISSION AMBER (DEFAULT) ───────────────────────────────────────── */
:root {
  /* Backgrounds — near-black, barely blue-tinted. Not "space" dark, just dark. */
  --void: #090C12;          /* Near-black main background */
  --void-elevated: #0D1220; /* Slightly lifted panel */
  --void-panel: #111827;    /* Sidebar and secondary surfaces */

  /* Glass surfaces — dark glass, no colored tint */
  --glass-fill: rgba(13, 18, 32, 0.9);
  --glass-fill-hover: rgba(17, 24, 39, 0.95);
  --glass-border: rgba(255, 255, 255, 0.08);
  --glass-border-hover: rgba(255, 255, 255, 0.16);

  /* Primary accent — Warm Amber (#E8960C) — analog gauge, CRT phosphor */
  --electric-cyan: #E8960C;
  --cyan-dim: rgba(232, 150, 12, 0.12);
  --cyan-glow: rgba(232, 150, 12, 0.25);

  /* Secondary accent — Steel Blue (#4A90D9) — calm radar display */
  --amber-gold: #4A90D9;
  --amber-dim: rgba(74, 144, 217, 0.12);
  --amber-glow: rgba(74, 144, 217, 0.25);

  /* Positive — Confident green (#2EBD6E) — not neon, just clear */
  --rally: #2EBD6E;
  --rally-dim: rgba(46, 189, 110, 0.12);
  --rally-border: rgba(46, 189, 110, 0.35);

  /* Warning */
  --warning: #E8960C;
  --warning-dim: rgba(232, 150, 12, 0.12);

  /* Negative — Honest red (#DC3545) — not coral, just red */
  --selloff: #DC3545;
  --selloff-dim: rgba(220, 53, 69, 0.12);
  --selloff-border: rgba(220, 53, 69, 0.35);

  --neutral: #4B5563;

  /* Typography */
  --ink: #E4EAF2;           /* Primary text — slightly warm white */
  --slate: #7A8FA8;         /* Secondary text — blue-gray */
  --slate-light: #A8B8CC;   /* Lighter secondary */
  --signal-gold: #E8960C;
  --signal-gold-dim: rgba(232, 150, 12, 0.12);
  --signal-gold-glow: rgba(232, 150, 12, 0.25);

  /* Brand gradient — amber to steel blue */
  --theme-gradient: linear-gradient(135deg, #E8960C 0%, #4A90D9 100%);

  /* Semantic aliases */
  --accent-bullish: var(--rally);
  --accent-bullish-dim: var(--rally-dim);
  --accent-bullish-border: var(--rally-border);
  --accent-bearish: var(--selloff);
  --accent-bearish-dim: var(--selloff-dim);
  --accent-bearish-border: var(--selloff-border);
  --border-color: rgba(255, 255, 255, 0.08);

  /* Theme-agnostic semantic tokens */
  --accent-primary: var(--electric-cyan);
  --accent-secondary: var(--amber-gold);
  --accent-positive: var(--rally);
  --accent-negative: var(--selloff);
  --text-primary: var(--ink);
  --text-secondary: var(--slate);
  --text-muted: var(--slate);

  /* Spacing */
  --gap-xs: 4px;
  --gap-sm: 8px;
  --gap-md: 16px;
  --gap-lg: 24px;
  --gap-xl: 40px;

  /* Radius */
  --radius-card: 10px;
  --radius-badge: 5px;
  --radius-sm: 4px;

  /* Pipeline */
  --pipeline-connector: 1px solid rgba(255,255,255,0.07);
  --pipeline-step-active: var(--electric-cyan);
  --pipeline-step-done: var(--rally);
  --pipeline-step-pending: var(--slate);
}


/* ─── 2. RETROWAVE DUSK THEME (NEON SYNTHWAVE PURPLE) ────────────────────────── */
[data-theme="synthwave"] {
 /* Backgrounds — deep neon violet purple */
 --void: #120420;
 --void-elevated: #1D0A34;
 --void-panel: #2B1055;

 /* Glass surfaces — rich purple tint */
 --glass-fill: rgba(29, 10, 52, 0.92);
 --glass-fill-hover: rgba(45, 16, 78, 0.96);
 --glass-border: rgba(255, 0, 127, 0.28);
 --glass-border-hover: rgba(157, 78, 221, 0.65);

 /* Primary accent — Hot Magenta Pink */
 --amber-gold: #FF007F;
 --amber-dim: rgba(255, 0, 127, 0.18);
 --amber-glow: rgba(255, 0, 127, 0.45);

 /* Secondary accent — Sunset Purple & Cyan */
 --electric-cyan: #9D4EDD;
 --cyan-dim: rgba(157, 78, 221, 0.18);
 --cyan-glow: rgba(157, 78, 221, 0.45);

 /* Positive — Electric Cyan Mint UP */
 --rally: #00FFD1;
 --rally-dim: rgba(0, 255, 209, 0.18);
 --rally-border: rgba(0, 255, 209, 0.48);

 /* Negative — Neon Magenta DOWN */
 --selloff: #FF0055;
 --selloff-dim: rgba(255, 0, 85, 0.18);
 --selloff-border: rgba(255, 0, 85, 0.48);

 --signal-gold: #FF007F;
 --signal-gold-dim: rgba(255, 0, 127, 0.18);
 --signal-gold-glow: rgba(255, 0, 127, 0.45);

 --theme-gradient: linear-gradient(135deg, #FF007F 0%, #9D4EDD 100%);
 --ink: #FDF4FF; /* Lilac White */
 --slate: #A855F7; /* Bright Purple Slate */
 --slate-light: #E9D5FF; /* Soft Lilac Light */
 --neutral: #8878A0;

 --accent-bullish: var(--rally);
 --accent-bullish-dim: var(--rally-dim);
 --accent-bullish-border: var(--rally-border);
 --accent-bearish: var(--selloff);
 --accent-bearish-dim: var(--selloff-dim);
 --accent-bearish-border: var(--selloff-border);
 --border-color: rgba(255, 0, 127, 0.15);

 --accent-primary: var(--amber-gold);
 --accent-secondary: var(--electric-cyan);
 --accent-positive: var(--rally);
 --accent-negative: var(--selloff);
 --pipeline-step-active: var(--amber-gold);
}


/* ─── 3. TELEMETRY GREEN THEME (EMERALD MATRIX TERMINAL) ─────────────────────── */
[data-theme="matrix"] {
 /* Backgrounds — deep emerald green black */
 --void: #020E06;
 --void-elevated: #061C0D;
 --void-panel: #0A2914;

 /* Glass surfaces — emerald terminal glass */
 --glass-fill: rgba(6, 28, 13, 0.92);
 --glass-fill-hover: rgba(12, 45, 22, 0.96);
 --glass-border: rgba(0, 255, 65, 0.28);
 --glass-border-hover: rgba(0, 245, 212, 0.65);

 /* Primary accent — Phosphor Matrix Green */
 --amber-gold: #00FF41;
 --amber-dim: rgba(0, 255, 65, 0.18);
 --amber-glow: rgba(0, 255, 65, 0.45);

 /* Secondary accent — Mint Teal */
 --electric-cyan: #00F5D4;
 --cyan-dim: rgba(0, 245, 212, 0.18);
 --cyan-glow: rgba(0, 245, 212, 0.45);

 /* Positive — Laser Lime UP */
 --rally: #39FF14;
 --rally-dim: rgba(57, 255, 20, 0.18);
 --rally-border: rgba(57, 255, 20, 0.48);

 /* Negative — Crimson Alert DOWN */
 --selloff: #FF3366;
 --selloff-dim: rgba(255, 51, 102, 0.18);
 --selloff-border: rgba(255, 51, 102, 0.48);

 --signal-gold: #00FF41;
 --signal-gold-dim: rgba(0, 255, 65, 0.18);
 --signal-gold-glow: rgba(0, 255, 65, 0.45);

 --theme-gradient: linear-gradient(135deg, #00FF41 0%, #00F5D4 100%);
 --ink: #DCFCE7; /* Phosphor Ivory */
 --slate: #4ADE80; /* Bright Green Slate */
 --slate-light: #86EFAC; /* Sage Light */
 --neutral: #4A7A55;

 --accent-bullish: var(--rally);
 --accent-bullish-dim: var(--rally-dim);
 --accent-bullish-border: var(--rally-border);
 --accent-bearish: var(--selloff);
 --accent-bearish-dim: var(--selloff-dim);
 --accent-bearish-border: var(--selloff-border);
 --border-color: rgba(0, 255, 65, 0.15);

 --accent-primary: var(--amber-gold);
 --accent-secondary: var(--electric-cyan);
 --accent-positive: var(--rally);
 --accent-negative: var(--selloff);
 --pipeline-step-active: var(--amber-gold);
}


/* ─── 4. SOLAR MISSION THEME (BURNT SOLAR AMBER & GOLD) ──────────────────────── */
[data-theme="solar"] {
 /* Backgrounds — deep charcoal solar amber */
 --void: #120902;
 --void-elevated: #1E1005;
 --void-panel: #301A09;

 /* Glass surfaces — solar amber glass */
 --glass-fill: rgba(30, 16, 5, 0.92);
 --glass-fill-hover: rgba(48, 26, 8, 0.96);
 --glass-border: rgba(255, 107, 0, 0.30);
 --glass-border-hover: rgba(255, 214, 0, 0.65);

 /* Primary accent — Vivid Solar Orange */
 --amber-gold: #FF6B00;
 --amber-dim: rgba(255, 107, 0, 0.18);
 --amber-glow: rgba(255, 107, 0, 0.45);

 /* Secondary accent — Solar Gold */
 --electric-cyan: #FFD600;
 --cyan-dim: rgba(255, 214, 0, 0.18);
 --cyan-glow: rgba(255, 214, 0, 0.45);

 /* Positive — Warm Gold UP */
 --rally: #FFB700;
 --rally-dim: rgba(255, 183, 0, 0.18);
 --rally-border: rgba(255, 183, 0, 0.48);

 /* Negative — Crimson Flare DOWN */
 --selloff: #FF1744;
 --selloff-dim: rgba(255, 23, 68, 0.18);
 --selloff-border: rgba(255, 23, 68, 0.48);

 --signal-gold: #FF6B00;
 --signal-gold-dim: rgba(255, 107, 0, 0.18);
 --signal-gold-glow: rgba(255, 107, 0, 0.45);

 --theme-gradient: linear-gradient(135deg, #FF6B00 0%, #FFD600 100%);
 --ink: #FFFBEB; /* Warm Solar Ivory */
 --slate: #F59E0B; /* Amber Slate */
 --slate-light: #FDE68A; /* Soft Gold Light */
 --neutral: #8A6040;

 --accent-bullish: var(--rally);
 --accent-bullish-dim: var(--rally-dim);
 --accent-bullish-border: var(--rally-border);
 --accent-bearish: var(--selloff);
 --accent-bearish-dim: var(--selloff-dim);
 --accent-bearish-border: var(--selloff-border);
 --border-color: rgba(255, 107, 0, 0.15);

 --accent-primary: var(--amber-gold);
 --accent-secondary: var(--electric-cyan);
 --accent-positive: var(--rally);
 --accent-negative: var(--selloff);
 --pipeline-step-active: var(--amber-gold);
}

/* ─── RESET & BOX MODEL ──────────────────────────────────────────────────────── */
*,
*::before,
*::after {
 box-sizing: border-box;
 margin: 0;
 padding: 0;
 -webkit-tap-highlight-color: transparent;
}


/* ─── BASE BODY — SETTLE FANTASTIC FOUR SPACE AMBIENCE ─────────────────────── */
body {
 background-color: var(--void);
 color: var(--ink);
 font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
 font-size: 14px;
 line-height: 1.6;
 min-height: 100vh;
 overflow-x: hidden;
 position: relative;
 transition: background-color 0.4s ease, color 0.4s ease;

 /* Single subtle top-edge ambient glow — not a grid, not a galaxy */
 background-image:
 radial-gradient(ellipse 70% 35% at 50% -5%, rgba(232, 150, 12, 0.06) 0%, transparent 100%);
 background-size: 100% 100%;
}

/* Vignette removed — was darkening content area */

/* Orbitron: kept for backward compat but use sparingly */
.font-orbitron {
 font-family: 'Space Grotesk', sans-serif;
 letter-spacing: 0.04em;
 font-weight: 700;
}

/* Mono type — IBM Plex Mono only */
.font-jetbrains,
.price,
.percentage,
.ticker-mono,
.timestamp {
 font-family: 'IBM Plex Mono', monospace;
}

.font-inter,
.font-body {
 font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
 line-height: 1.6;
}

.font-retro,
.retro-tag,
.terminal-code {
 font-family: 'Share Tech Mono', 'IBM Plex Mono', monospace;
 letter-spacing: 0.04em;
 text-transform: uppercase;
}

.font-vt323 {
 font-family: 'VT323', monospace;
 font-size: 1.25rem;
 letter-spacing: 0.08em;
}

.font-display,
.font-space,
h1, h2, h3, h4 {
 font-family: 'Space Grotesk', sans-serif;
 letter-spacing: -0.02em;
}

/* Orbitron reserved ONLY for key identity moments — not general headings */
.font-orbitron {
 font-family: 'Orbitron', 'Space Grotesk', sans-serif;
 letter-spacing: 0.06em;
 text-transform: uppercase;
}

.font-body {
 font-family: 'Public Sans', sans-serif;
 line-height: 1.65;
}

.font-mono,
.price,
.percentage,
.ticker-mono,
.timestamp,
[data-numeric] {
 font-family: 'IBM Plex Mono', monospace;
 font-variant-numeric: tabular-nums;
 letter-spacing: -0.02em;
}

/* ─── CREATIVE GLOW UTILITIES ────────────────────────────────────────────────── */
.glow-amber {
 box-shadow: 0 0 16px var(--amber-glow);
}

.glow-cyan {
 box-shadow: 0 0 16px var(--cyan-glow);
}

.glow-rally {
 box-shadow: 0 0 16px rgba(0, 255, 102, 0.35);
}

.glow-selloff {
 box-shadow: 0 0 16px rgba(255, 42, 84, 0.35);
}

/* Theme-aware glow utilities */
.glow-bullish {
 box-shadow: 0 0 16px var(--accent-bullish-dim);
}
.glow-bearish {
 box-shadow: 0 0 16px var(--accent-bearish-dim);
}

.text-gradient {
 background: var(--theme-gradient);
 -webkit-background-clip: text;
 -webkit-text-fill-color: transparent;
}

/* ─── RETRO GLASS PANEL SYSTEM ───────────────────────────────────────────────── */
.glass-panel,
.glass-card {
 background: var(--glass-fill);
 backdrop-filter: blur(16px);
 -webkit-backdrop-filter: blur(16px);
 border: 1px solid var(--glass-border);
 border-radius: 12px;
 padding: var(--gap-lg);
 position: relative;
 overflow: hidden;
 box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.05);

 transition:
 background 0.3s ease,
 transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
 border-color 0.25s cubic-bezier(0.4, 0, 0.2, 1),
 box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Cards lift on hover — subtle, not dramatic. Only raise — no glow blast */
.glass-panel:hover,
.glass-card:hover {
 transform: translateY(-1px);
 border-color: rgba(255,255,255,0.2);
 box-shadow: 0 16px 40px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.06);
}

/* ─── BADGES ─────────────────────────────────────────────────────────────────── */
.badge-rally {
 background: var(--rally-dim);
 color: var(--rally);
 border: 1px solid var(--rally-border);
 box-shadow: 0 0 8px rgba(0, 255, 102, 0.25);
 font-weight: 700;
}

.badge-selloff {
 background: var(--selloff-dim);
 color: var(--selloff);
 border: 1px solid var(--selloff-border);
 box-shadow: 0 0 8px rgba(255, 42, 84, 0.25);
 font-weight: 700;
}

.badge-gold {
 background: var(--amber-dim);
 color: var(--amber-gold);
 border: 1px solid var(--amber-glow);
 box-shadow: 0 0 8px var(--amber-glow);
 font-weight: 700;
}

.badge-cyan {
 background: var(--cyan-dim);
 color: var(--electric-cyan);
 border: 1px solid var(--cyan-glow);
 box-shadow: 0 0 8px var(--cyan-glow);
 font-weight: 700;
}

/* ─── NAV TABS ───────────────────────────────────────────────────────────────── */
.nav-tab {
 position: relative;
 padding: 8px 16px;
 border-radius: 8px;
 border: 1px solid transparent;
 background: transparent;
 color: var(--slate);
 font-family: 'Share Tech Mono', monospace;
 font-size: 0.76rem;
 font-weight: 600;
 letter-spacing: 0.06em;
 text-transform: uppercase;
 cursor: pointer;
 transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.nav-tab:hover {
 color: var(--ink);
 background: var(--amber-dim);
 border-color: var(--amber-glow);
}

.nav-tab.active {
 color: var(--amber-gold);
 background: var(--amber-dim);
 border-color: var(--amber-glow);
 box-shadow: 0 0 12px var(--amber-glow);
}

.nav-tab:focus-visible {
 outline: 2px solid var(--electric-cyan);
 outline-offset: 2px;
}

.dashboard-grid-2col {
 display: grid;
 grid-template-columns: 1fr;
 gap: 24px;
}

.dashboard-grid-2col > * {
 min-width: 0;
}

@media (min-width: 1024px) {
 .dashboard-grid-2col {
 grid-template-columns: 1fr 1fr;
 }
}

.dashboard-grid-3col {
 display: grid;
 grid-template-columns: 1fr;
 gap: 20px;
}

/* ─── RISK COCKPIT ──────────────────────────────────────────────────────────── */
.risk-cockpit {
 position: relative;
 overflow: hidden;
 padding: 20px;
 border: 1px solid color-mix(in srgb, var(--electric-cyan) 32%, var(--glass-border));
 border-radius: 8px;
 background: linear-gradient(120deg, rgba(35, 76, 98, 0.32), rgba(11, 18, 32, 0.2) 52%), var(--glass-fill);
 box-shadow: 0 14px 38px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.07);
}

.risk-cockpit-header,
.cockpit-footer,
.cockpit-status,
.cockpit-card-label,
.cockpit-metric,
.cockpit-link,
.eyebrow-label { display: flex; align-items: center; }

.risk-cockpit-header { position: relative; z-index: 1; justify-content: space-between; gap: 18px; margin-bottom: 16px; }
.eyebrow-label, .cockpit-card-label { gap: 7px; color: var(--electric-cyan); font-family: 'JetBrains Mono', monospace; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.08em; }
.risk-cockpit h1 { margin: 6px 0 4px; font-size: clamp(1.18rem, 2vw, 1.55rem); letter-spacing: 0; }
.risk-cockpit-header p { max-width: 650px; color: var(--slate-light); font-size: 0.82rem; line-height: 1.45; }

.cockpit-status { flex-shrink: 0; flex-wrap: wrap; justify-content: center; gap: 7px; min-width: 126px; padding: 10px 14px; border: 1px solid var(--amber-glow); border-radius: 8px; background: var(--amber-dim); color: var(--amber-gold); font-family: 'JetBrains Mono', monospace; font-size: 0.76rem; font-weight: 800; letter-spacing: 0.06em; }
.cockpit-status small { flex-basis: 100%; color: var(--slate-light); font-size: 0.68rem; font-weight: 500; letter-spacing: 0; text-align: center; }
.cockpit-status-observe { border-color: var(--cyan-glow); background: var(--cyan-dim); color: var(--electric-cyan); }
.cockpit-status-dot, .cockpit-footer-dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; box-shadow: 0 0 10px currentColor; }

.cockpit-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.35fr 1fr 1fr; gap: 12px; }
.cockpit-card { min-height: 128px; padding: 16px; border: 1px solid var(--glass-border); border-radius: 8px; background: rgba(0, 0, 0, 0.14); }
.cockpit-card-primary { border-color: color-mix(in srgb, var(--amber-gold) 35%, var(--glass-border)); background: linear-gradient(145deg, var(--amber-dim), rgba(0, 0, 0, 0.12)); }
.cockpit-card-label { margin-bottom: 10px; color: var(--slate); font-size: 0.62rem; }
.cockpit-card strong { display: block; margin-bottom: 8px; color: var(--ink); font-size: 1rem; }
.cockpit-card p { color: var(--slate-light); font-size: 0.76rem; line-height: 1.45; }
.cockpit-value { margin-bottom: 8px; color: var(--ink); font-family: 'IBM Plex Mono', monospace; font-size: 1.42rem; font-weight: 700; }
.cockpit-value-small { font-family: 'Space Grotesk', sans-serif; font-size: 1rem; }
.cockpit-metric { gap: 7px; margin-bottom: 10px; color: var(--rally); font-family: 'IBM Plex Mono', monospace; font-size: 0.86rem; font-weight: 700; }
.cockpit-metric span { color: var(--slate); font-family: 'Space Grotesk', sans-serif; font-size: 0.7rem; font-weight: 500; }
.metric-negative { color: var(--selloff); }
.cockpit-muted { color: var(--slate) !important; }
.cockpit-link { gap: 6px; margin-top: 10px; padding: 0; border: 0; background: transparent; color: var(--amber-gold); font-size: 0.74rem; font-weight: 700; cursor: pointer; }
.cockpit-link:hover { color: var(--ink); }
.cockpit-footer { position: relative; z-index: 1; justify-content: space-between; gap: 12px; margin-top: 12px; color: var(--slate); font-family: 'JetBrains Mono', monospace; font-size: 0.64rem; }
.cockpit-footer span:first-child { display: inline-flex; align-items: center; gap: 7px; color: var(--rally); }

@media (max-width: 900px) { .cockpit-grid { grid-template-columns: 1fr 1fr; } .cockpit-card-primary { grid-column: 1 / -1; } }
@media (max-width: 620px) {
 .risk-cockpit { padding: 18px; }
 .risk-cockpit-header { align-items: flex-start; flex-direction: column; }
 .cockpit-status { align-self: stretch; justify-content: flex-start; }
 .cockpit-status small { flex: 0 0 auto; margin-left: auto; }
 .cockpit-grid { grid-template-columns: 1fr; }
 .cockpit-card-primary { grid-column: auto; }
 .cockpit-footer { align-items: flex-start; flex-direction: column; }
}

/* ─── PORTFOLIO STRESS EXPLORER ────────────────────────────────────────────── */
.portfolio-stress-control { margin-bottom: 20px; padding: 18px; border: 1px solid color-mix(in srgb, var(--accent-bearish) 28%, var(--glass-border)); border-radius: 12px; background: linear-gradient(140deg, var(--accent-bearish-dim), rgba(0, 0, 0, 0.12)); }
.portfolio-stress-control-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
.portfolio-stress-control-header strong { display: block; margin-top: 8px; color: var(--ink); font-size: 0.94rem; }
.portfolio-stress-loss { color: var(--accent-bearish); font-size: 1.35rem; font-weight: 700; }
.portfolio-stress-tabs { display: flex; gap: 8px; margin: 18px 0; overflow-x: auto; padding-bottom: 3px; }
.portfolio-stress-tab { flex-shrink: 0; padding: 8px 11px; border: 1px solid var(--glass-border); border-radius: 8px; background: rgba(0, 0, 0, 0.16); color: var(--slate); font-size: 0.72rem; cursor: pointer; }
.portfolio-stress-tab.active { border-color: var(--accent-bearish); background: var(--accent-bearish-dim); color: var(--ink); }
.portfolio-stress-slider-label, .portfolio-stress-scale { display: flex; justify-content: space-between; gap: 12px; color: var(--slate-light); font-size: 0.72rem; }
.portfolio-stress-slider { width: 100%; margin: 12px 0 8px; accent-color: var(--accent-bearish); cursor: pointer; }
.portfolio-stress-scale { color: var(--slate); font-family: 'IBM Plex Mono', monospace; font-size: 0.64rem; }
.portfolio-stress-note { margin-top: 14px; color: var(--slate) !important; font-size: 0.72rem !important; }

@media (max-width: 620px) {
 .portfolio-stress-control-header { flex-direction: column; }
 .portfolio-stress-loss { font-size: 1.15rem; }
 .portfolio-stress-scale span:nth-child(2) { text-align: center; }
}

/* ─── MOBILE NAVIGATION ────────────────────────────────────────────────────── */
.mobile-bottom-nav { display: none; }
@media (max-width: 767px) {
 .mobile-bottom-nav {
 position: fixed;
 z-index: 1000;
 right: 0;
 bottom: 0;
 left: 0;
 display: flex;
 justify-content: space-around;
 gap: 2px;
 overflow-x: auto;
 padding: 5px 4px calc(5px + env(safe-area-inset-bottom));
 border-top: 1px solid var(--glass-border);
 background: color-mix(in srgb, var(--void-elevated) 92%, transparent);
 backdrop-filter: blur(18px);
 -webkit-backdrop-filter: blur(18px);
 }
 .mobile-bottom-nav button { flex: 1 0 auto; min-width: 64px; }
 .app-main { padding-bottom: 76px; }
}

@media (min-width: 900px) {
 .dashboard-grid-3col {
 grid-template-columns: 1fr 1fr 1fr;
 }
}

/* ─── SKELETON PULSE ──────────────────────────────────────────────────────────── */
@keyframes skeleton-shimmer {
 0% { opacity: 0.3; }
 50% { opacity: 0.7; }
 100% { opacity: 0.3; }
}

.skeleton-pulse {
 animation: skeleton-shimmer 1.8s ease-in-out infinite;
}

.chart-skeleton {
 height: 440px;
 display: flex;
 flex-direction: column;
 justify-content: space-between;
 overflow: hidden;
}

.chart-skeleton-header {
 display: flex;
 justify-content: space-between;
 gap: 16px;
}

.chart-skeleton-header span {
 display: block;
 width: 170px;
 height: 18px;
 border-radius: 5px;
 background: var(--glass-border);
 animation: skeleton-shimmer 1.8s ease-in-out infinite;
}

.chart-skeleton-header span:last-child {
 width: 90px;
}

.chart-skeleton-plot {
 position: relative;
 flex: 1;
 margin: 28px 0;
 border-bottom: 1px solid var(--glass-border);
 background: repeating-linear-gradient(
 to bottom,
 transparent 0,
 transparent 54px,
 rgba(255, 255, 255, 0.05) 55px
 );
}

.chart-skeleton-line {
 position: absolute;
 left: 5%;
 right: 5%;
 height: 2px;
 border-radius: 2px;
 background: var(--cyan-glow);
 transform: rotate(-4deg);
 animation: skeleton-shimmer 1.8s ease-in-out infinite;
}

.line-one {
 top: 42%;
}

.line-two {
 top: 52%;
 background: var(--amber-glow);
 transform: rotate(3deg);
 animation-delay: 220ms;
}

.chart-skeleton-bars {
 position: absolute;
 right: 6%;
 bottom: 0;
 left: 6%;
 height: 26%;
 opacity: 0.45;
 background: repeating-linear-gradient(
 90deg,
 var(--cyan-dim) 0 5px,
 transparent 5px 18px
 );
}

.chart-skeleton-status {
 display: flex;
 align-items: center;
 gap: 8px;
 color: var(--slate);
 font-family: 'IBM Plex Mono', monospace;
 font-size: 0.76rem;
}

/* ─── RETRO ANIMATIONS ───────────────────────────────────────────────────────── */
@keyframes blink-dot {
 0%, 100% { opacity: 1; filter: drop-shadow(0 0 5px var(--rally)); }
 50% { opacity: 0.2; }
}

.retro-blink {
 animation: blink-dot 1.2s infinite;
}

@keyframes panel-rise {
 from { opacity: 0; transform: translateY(12px); }
 to { opacity: 1; transform: translateY(0); }
}

.panel-appear {
 animation: panel-rise 250ms ease-out both;
}

@keyframes spin {
 from { transform: rotate(0deg); }
 to { transform: rotate(360deg); }
}

.spin {
 animation: spin 1s linear infinite;
 display: inline-block;
}

/* ─── DATA TABLE ─────────────────────────────────────────────────────────────── */
.data-table {
 width: 100%;
 border-collapse: separate;
 border-spacing: 0;
 font-family: 'IBM Plex Mono', monospace;
 font-variant-numeric: tabular-nums;
}

.data-table thead th {
 text-align: left;
 font-family: 'Share Tech Mono', 'Space Grotesk', monospace;
 font-size: 0.76rem;
 font-weight: 700;
 color: var(--slate-light);
 text-transform: uppercase;
 letter-spacing: 0.06em;
 padding: 12px 14px;
 border-bottom: 1px solid var(--glass-border);
 background: rgba(0, 0, 0, 0.3);
 cursor: pointer;
 user-select: none;
}

.data-table thead th:hover,
.data-table thead th.sorted {
 color: var(--amber-gold);
}

.data-table tbody tr {
 transition: background 0.15s ease;
}

.data-table tbody tr:hover {
 background: var(--cyan-dim);
}

.data-table tbody td {
 padding: 12px 14px;
 border-bottom: 1px solid rgba(255, 255, 255, 0.04);
 font-size: 0.88rem;
 color: var(--ink);
 vertical-align: middle;
}

/* ─── CUSTOM SCROLLBARS ──────────────────────────────────────────────────────── */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: var(--void); }
::-webkit-scrollbar-thumb { background: var(--cyan-glow); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: var(--amber-gold); }

/* ── Pipeline connector line ──────────────────────────────── */
.pipeline-line {
 width: 2px;
 background: var(--pipeline-connector);
 flex-shrink: 0;
 border-radius: 2px;
}

.pipeline-step {
 display: flex;
 align-items: center;
 gap: var(--gap-sm);
 padding: 6px 0;
 font-family: 'IBM Plex Mono', monospace;
 font-size: 0.72rem;
 color: var(--pipeline-step-pending);
 cursor: default;
 transition: color 0.2s ease;
}

.pipeline-step.active {
 color: var(--pipeline-step-active);
}

.pipeline-step.done {
 color: var(--pipeline-step-done);
}

.pipeline-step-dot {
 width: 8px;
 height: 8px;
 border-radius: 50%;
 border: 1.5px solid currentColor;
 flex-shrink: 0;
 transition: background 0.2s ease;
}

.pipeline-step.active .pipeline-step-dot,
.pipeline-step.done .pipeline-step-dot {
 background: currentColor;
}

/* ── Sidebar layout ───────────────────────────────────────── */
.app-layout {
 flex: 1;
 display: flex;
 min-height: 0; /* Crucial for flexbox children overflow scrolling */
 overflow: hidden;
}

.app-sidebar {
 width: 220px;
 min-width: 220px;
 background: var(--void-panel);
 border-right: 1px solid var(--glass-border);
 display: flex;
 flex-direction: column;
 padding: var(--gap-md) var(--gap-sm);
 overflow-y: auto;
 gap: var(--gap-xs);
 transition: width 0.25s ease, min-width 0.25s ease;
 flex-shrink: 0;
 -webkit-overflow-scrolling: touch;
}

.app-sidebar.collapsed {
 width: 56px;
 min-width: 56px;
}

.sidebar-nav-item {
 display: flex;
 align-items: center;
 gap: 8px;
 padding: 7px 10px;
 border-radius: var(--radius-badge);
 cursor: pointer;
 font-family: 'Inter', sans-serif;
 font-size: 0.8rem;
 font-weight: 450;
 color: var(--slate);
 letter-spacing: 0;
 transition: color 0.15s ease, background 0.15s ease;
 border: 1px solid transparent;
 border-left: 2px solid transparent;
 white-space: nowrap;
 overflow: hidden;
 text-overflow: ellipsis;
}

/* Active state: left accent bar — feels like a real product, not a template */
.sidebar-nav-item.active {
 background: color-mix(in srgb, var(--accent-primary) 8%, transparent);
 color: var(--ink);
 border-color: transparent;
 border-left: 2px solid var(--accent-primary);
 padding-left: 8px; /* compensate for border width */
 font-weight: 600;
}

/* Inactive hover: just lighten, no border flash */
.sidebar-nav-item:hover:not(.active) {
 background: rgba(255,255,255,0.04);
 color: var(--slate-light);
 border-color: transparent;
}

.sidebar-step-number {
 font-size: 0.62rem;
 font-family: 'IBM Plex Mono', monospace;
 color: var(--slate);
 margin-left: auto;
 flex-shrink: 0;
 opacity: 0.7;
}

.app-main {
 flex: 1;
 min-height: 0;
 min-width: 0;
 overflow-y: auto;
 overflow-x: hidden;
 padding-bottom: 60px;
 -webkit-overflow-scrolling: touch;
}

/* ── Custom Sleek Retro Scrollbars ────────────────────────── */
::-webkit-scrollbar {
 width: 6px;
 height: 6px;
}

::-webkit-scrollbar-track {
 background: var(--void-panel);
}

::-webkit-scrollbar-thumb {
 background: color-mix(in srgb, var(--accent-primary) 35%, transparent);
 border-radius: 3px;
}

::-webkit-scrollbar-thumb:hover {
 background: var(--accent-primary);
}

* {
 scrollbar-width: thin;
 scrollbar-color: color-mix(in srgb, var(--accent-primary) 35%, transparent) var(--void-panel);
}

/* Sidebar section separator — restrained, not loud */
.sidebar-section-label {
 font-family: 'IBM Plex Mono', monospace;
 font-size: 0.58rem;
 color: var(--slate);
 letter-spacing: 0.14em;
 text-transform: uppercase;
 padding: 12px 10px 4px;
 opacity: 0.4;
 border-top: 1px solid rgba(255,255,255,0.05);
 margin-top: 4px;
}

/* ── Pipeline next-step CTA ───────────────────────────────── */
.pipeline-cta {
 display: inline-flex;
 align-items: center;
 gap: 6px;
 padding: 8px 14px;
 border: 1px solid color-mix(in srgb, var(--accent-primary) 40%, transparent);
 background: color-mix(in srgb, var(--accent-primary) 8%, transparent);
 border-radius: var(--radius-badge);
 color: var(--accent-primary);
 font-family: 'IBM Plex Mono', monospace;
 font-size: 0.72rem;
 cursor: pointer;
 transition: all 0.18s ease;
 letter-spacing: 0.05em;
 text-transform: uppercase;
}

.pipeline-cta:hover {
 background: color-mix(in srgb, var(--accent-primary) 18%, transparent);
 border-color: var(--accent-primary);
 transform: translateX(2px);
}

.pipeline-module-footer {
 margin-top: var(--gap-xl);
 padding: var(--gap-md) var(--gap-lg);
 border-top: var(--pipeline-connector);
 display: flex;
 align-items: center;
 justify-content: space-between;
 flex-wrap: wrap;
 gap: var(--gap-sm);
}

.pipeline-module-footer-label {
 font-family: 'IBM Plex Mono', monospace;
 font-size: 0.68rem;
 color: var(--slate);
 letter-spacing: 0.08em;
 opacity: 0.7;
}

/* ── Accessibility: Reduced Motion ─────────────────────────────────────────── */
/* Disable all animations and transitions for users with vestibular disorders */
@media (prefers-reduced-motion: reduce) {
 *,
 *::before,
 *::after {
 animation-duration: 0.01ms !important;
 animation-iteration-count: 1 !important;
 transition-duration: 0.01ms !important;
 scroll-behavior: auto !important;
 }

 /* Specifically disable known heavy animations */
 .pipeline-progress-dot {
 animation: none !important;
 }

 .behavioral-nudge-banner {
 animation: none !important;
 }

 .hype-badge-pulse,
 .health-score-arc,
 .loading-spinner,
 .skeleton-shimmer {
 animation: none !important;
 }

 /* Preserve opacity/color transitions for interactive states (hover, focus) */
 /* but skip motion-heavy transforms */
 [class*="animate-"],
 [class*="spin"],
 [class*="pulse"],
 [class*="bounce"] {
 animation: none !important;
 transform: none !important;
 }
}
